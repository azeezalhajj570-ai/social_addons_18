services:
  db:
    image: postgres:15
    container_name: odoo18-db
    restart: unless-stopped
    environment:
      POSTGRES_DB: odoo18
      POSTGRES_USER: odoo
      POSTGRES_PASSWORD: odoo
    volumes:
      - odoo18_db:/var/lib/postgresql/data

  odoo:
    image: alirezakatiraie/odoo18e:v18.0-e.20250915
    container_name: odoo18
    depends_on:
      - db
    restart: unless-stopped
    ports:
      - "8069:8069"
    environment:
      HOST: db
      USER: odoo
      PASSWORD: odoo

    volumes:
      - odoo18_data:/var/lib/odoo
      - ./config/odoo.conf:/app/odoo.conf
      - ./social_addons_18:/app/custom-addons/social_addons_18


volumes:
  odoo18_db:
  odoo18_data:
