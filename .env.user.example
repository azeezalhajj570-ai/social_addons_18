API_ID=123456
API_HASH=your_api_hash

# Optional if provided by auth-web flow:
# SESSION_STRING=

USER_CLIENT_AUTH_PORT=8000
USER_CLIENT_DB_NAME=user_client
USER_CLIENT_REDIS_DB=2

# Optional override. If unset, compose builds:
# postgresql://${DB_USER}:${DB_PASS}@postgres:5432/${USER_CLIENT_DB_NAME}
# USER_CLIENT_DB_URL=
# redis://:${REDIS_PASS}@redis:${REDIS_PORT}/$USER_CLIENT_REDIS_DB
# USER_CLIENT_REDIS_URL=

# Optional defaults:
# SESSION_NAME=user_client
# USER_CLIENT_DB_PATH=/usr/src/app/user_client_data/user_client.db
# AUTO_REPLY_USER_ID=0
# AUTO_REPLY_TEXT=Hello
# AUTO_REPLY_COOLDOWN_SECONDS=8
# SCHEDULER_POLL_SECONDS=2

# Odoo integration (optional)
# ODOO_ENABLED=0
# ODOO_URL=
# ODOO_DB=
# ODOO_USERNAME=
# ODOO_PASSWORD=
# ODOO_AUTO_REPLY_MODEL=telegram.auto.reply.route
# ODOO_ACCOUNT_MODEL=telegram.user.account
# ODOO_ACCOUNT_REF=user_client
# ODOO_PHONE_NUMBER=
# ODOO_SYNC_SECONDS=30
